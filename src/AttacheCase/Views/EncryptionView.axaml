<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:AttacheCase.ViewModels"
             xmlns:l="using:AttacheCase.Markup"
             xmlns:controls="using:AttacheCase.Controls"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d" d:DesignWidth="800" d:DesignHeight="600"
             x:Class="AttacheCase.Views.EncryptionView"
             x:DataType="vm:EncryptionViewModel">

    <UserControl.Resources>
        <!-- 出力ファイルの種類コンボボックスの項目（24x24 アイコン + ラベル） -->
        <DataTemplate x:Key="FileTypeItemTemplate" x:DataType="vm:EncryptionFileTypeOption">
            <StackPanel Orientation="Horizontal" Spacing="6">
                <Image Source="{Binding Icon}" Width="24" Height="24"
                       Stretch="Uniform" VerticalAlignment="Center" />
                <TextBlock Text="{Binding Label}" VerticalAlignment="Center" />
            </StackPanel>
        </DataTemplate>
    </UserControl.Resources>

    <Grid>

      <!-- 対象のパス。左端は入力欄のコンボ、右端は入力欄の右端（戻るボタンの左）に揃える。
           2 行まで全文、入らなければ PathTextBlock が途中を省略する -->
      <controls:PathTextBlock
        VerticalAlignment="Top"
        HorizontalAlignment="Stretch"
        Margin="20,60,54,0"
        Text="{Binding TargetPath}"
        FontSize="13"
        Opacity="0.8"
        TextWrapping="Wrap"
        MaxLines="2"/>

      <!-- パスワード入力画面 (Step 1)

             入力欄そのものを画面の中心に据える。上下の * が同じ高さになるので、
             真ん中の Auto の行がちょうど中心に来る。まとめて中央そろえにすると、
             説明やボタンの高さのぶんだけ入力欄が下がって見える -->
        <Grid IsVisible="{Binding IsPasswordInputStep}" RowDefinitions="*,Auto,*">

            <TextBlock Grid.Row="0"
                      Text="{l:Localize Encryption_PasswordPrompt}"
                      FontSize="16"
                      HorizontalAlignment="Center"
                      VerticalAlignment="Bottom"
                      Margin="0,0,0,30"/>

            <!-- パスワード欄は中央のまま（下の強度バーと揃える）。
                 出力の種類コンボボックスはその左に置く -->
            <!-- 入力欄は中央、出力種別のコンボボックスはその左。左の列はコンボボックスが収まる固定幅、
                 右の列は右上の戻るボタン（44 + 右余白 10）ぶんを空け、入力欄の列だけが伸び縮みする。
                 左余白 20 は見出しと同じ。＝ 入力欄の右端が戻るボタンの左端に揃う（利用者要望 2026-10-25）。
                 以前は入力欄が固定 400 で両脇が * だったので、狭いウィンドウでコンボボックスが左へはみ出していた -->
            <Grid Grid.Row="1" ColumnDefinitions="112,*,54" Margin="20,0,0,0" HorizontalAlignment="Stretch">
              <!-- 出力ファイルの種類（ATC / EXE / ZIP）。ZIP を選ぶとパスワード ZIP 画面へ -->
              <ComboBox Grid.Column="0"
                        HorizontalAlignment="Right"
                        Margin="0,0,8,0"
                        MinWidth="104"
                        VerticalAlignment="Center"
                        ItemsSource="{Binding FileTypeOptions}"
                        SelectedItem="{Binding SelectedFileType}"
                        ToolTip.Tip="{l:Localize Encryption_FileTypeTooltip}"
                        ItemTemplate="{StaticResource FileTypeItemTemplate}" />
              <Grid Grid.Column="1">
                <TextBox x:Name="PasswordBox"
                        Text="{Binding Password1}"
                        IsEnabled="{Binding !IsPasswordFileMode}"
                        PasswordChar="{Binding PasswordVisibility.PasswordChar}"
                        Watermark="{l:Localize Encryption_PasswordPlaceholder}"
                        Padding="10,3,36,0"
                        Classes="password">
                    <TextBox.KeyBindings>
                        <KeyBinding Gesture="Enter" Command="{Binding NextCommand}" />
                    </TextBox.KeyBindings>
                </TextBox>
                <Button Classes="eye"
                        Command="{Binding PasswordVisibility.ToggleCommand}"
                        ToolTip.Tip="{Binding PasswordVisibility.ToolTip}">
                    <!-- SvgImage は Source を差し替えても Image が再描画されないため、
                         2 枚を用意して表示を切り替える -->
                    <Panel>
                        <Image Width="18" Height="18" Stretch="Uniform"
                               IsVisible="{Binding !PasswordVisibility.IsVisible}">
                            <Image.Source>
                                <SvgImage Source="{Binding PasswordVisibility.EyeBlindIconUri}" />
                            </Image.Source>
                        </Image>
                        <Image Width="18" Height="18" Stretch="Uniform"
                               IsVisible="{Binding PasswordVisibility.IsVisible}">
                            <Image.Source>
                                <SvgImage Source="{Binding PasswordVisibility.EyeIconUri}" />
                            </Image.Source>
                        </Image>
                    </Panel>
                </Button>
              </Grid>
            </Grid>

            <StackPanel Grid.Row="2"
                        VerticalAlignment="Top"
                        HorizontalAlignment="Stretch"
                        Spacing="20"
                        Margin="0,12,0,0">

                <!-- パスワード強度メーター（zxcvbn）。強度は目安。
                     バーは入力欄と同じ幅、ラベルはバーの右にはみ出してよい -->
                <Grid ColumnDefinitions="112,*,54" Margin="20,0,0,0" Height="16" HorizontalAlignment="Stretch"
                      IsVisible="{Binding IsPasswordStrengthMeterVisible}">
                    <ProgressBar Grid.Column="1" Minimum="0" Maximum="100"
                                 Value="{Binding PasswordStrengthValue}"
                                 Foreground="{Binding PasswordStrengthBrush}"
                                 Height="6"
                                 HorizontalAlignment="Stretch"
                                 VerticalAlignment="Center" />
                    <!-- ラベルは Canvas で置く。Margin ではみ出させると、親の幅を
                         超えたぶんが 0 幅に潰されて表示されない（Canvas は子を潰さない） -->
                    <Canvas Grid.Column="2">
                        <TextBlock Canvas.Left="8" Canvas.Top="-5"
                                   Text="{Binding PasswordStrengthLabel}"
                                   FontSize="11"
                                   Foreground="{Binding PasswordStrengthBrush}" />
                    </Canvas>
                </Grid>

                <!-- 暗号化後に元のファイルを削除する（設定「メインウィンドウに削除のチェックボックスを表示する」が ON のときだけ。
                     入力欄と同じ列に置く） -->
                <Grid ColumnDefinitions="112,*,54" Margin="20,0,0,0" HorizontalAlignment="Stretch"
                      IsVisible="{Binding IsDeleteCheckBoxVisible}">
                    <CheckBox Grid.Column="1"
                              Content="{l:Localize Settings_DeleteOriginalAfterEncryption}"
                              IsChecked="{Binding DeleteOriginalAfterEncryption}"
                              FontSize="12" />
                </Grid>

                <StackPanel Orientation="Horizontal"
                            Spacing="8"
                            HorizontalAlignment="Right"
                            Margin="0,0,54,0"
                            IsVisible="{Binding IsPasswordFileMode}">
                    <TextBlock Text="{Binding PasswordFileLabel}"
                               FontSize="12"
                               VerticalAlignment="Center" />
                    <Button Content="{l:Localize PasswordFile_Clear}"
                            Command="{Binding ClearPasswordFileCommand}"
                            FontSize="11"
                            Padding="8,2" />
                </StackPanel>

                <!-- ボタン列は中央寄せではなく右寄せ。右端を入力欄の右端（= 右上の戻るボタンの左端、右から 54）に
                     揃える（利用者指示 2026-10-25: 中央寄せはやめる） -->
                <StackPanel Orientation="Horizontal"
                           HorizontalAlignment="Right"
                           Margin="0,0,54,0"
                           Spacing="10">
                    <Button Classes="action Primary" Content="{l:Localize Button_Next}"
                           Command="{Binding NextCommand}"/>
                    <Button Classes="action" Content="{l:Localize Button_Cancel}"
                           Command="{Binding CancelCommand}"/>
                </StackPanel>
            </StackPanel>
        </Grid>

        <!-- パスワード確認画面 (Step 2)。Step 1 と同じ位置に入力欄が来るようにする -->
        <Grid IsVisible="{Binding IsPasswordConfirmStep}" RowDefinitions="*,Auto,*">

            <TextBlock Grid.Row="0"
                      Text="{l:Localize Encryption_PasswordConfirmPrompt}"
                      FontSize="16"
                      HorizontalAlignment="Center"
                      VerticalAlignment="Bottom"
                      TextWrapping="Wrap"
                      TextAlignment="Center"
                      MaxWidth="400"
                      Margin="0,0,0,30"/>

            <!-- 入力欄は中央、出力種別のコンボボックスはその左。左の列はコンボボックスが収まる固定幅、
                 右の列は右上の戻るボタン（44 + 右余白 10）ぶんを空け、入力欄の列だけが伸び縮みする。
                 左余白 20 は見出しと同じ。＝ 入力欄の右端が戻るボタンの左端に揃う（利用者要望 2026-10-25）。
                 以前は入力欄が固定 400 で両脇が * だったので、狭いウィンドウでコンボボックスが左へはみ出していた -->
            <Grid Grid.Row="1" ColumnDefinitions="112,*,54" Margin="20,0,0,0" HorizontalAlignment="Stretch">
              <ComboBox Grid.Column="0"
                        HorizontalAlignment="Right"
                        Margin="0,0,8,0"
                        MinWidth="104"
                        VerticalAlignment="Center"
                        ItemsSource="{Binding FileTypeOptions}"
                        SelectedItem="{Binding SelectedFileType}"
                        ToolTip.Tip="{l:Localize Encryption_FileTypeTooltip}"
                        ItemTemplate="{StaticResource FileTypeItemTemplate}" />
              <Grid Grid.Column="1">
                <TextBox x:Name="ConfirmPasswordBox"
                        Text="{Binding Password2}"
                        IsEnabled="{Binding !IsPasswordFileMode}"
                        PasswordChar="{Binding PasswordVisibility.PasswordChar}"
                        Watermark="{l:Localize Encryption_PasswordConfirmPlaceholder}"
                        Background="{Binding ConfirmPasswordBackground}"
                        Padding="10,3,36,0"
                        Classes="password">
                    <TextBox.KeyBindings>
                        <KeyBinding Gesture="Enter" Command="{Binding EncryptCommand}" />
                    </TextBox.KeyBindings>
                </TextBox>
                <Button Classes="eye"
                        Command="{Binding PasswordVisibility.ToggleCommand}"
                        ToolTip.Tip="{Binding PasswordVisibility.ToolTip}">
                    <!-- SvgImage は Source を差し替えても Image が再描画されないため、
                         2 枚を用意して表示を切り替える -->
                    <Panel>
                        <Image Width="18" Height="18" Stretch="Uniform"
                               IsVisible="{Binding !PasswordVisibility.IsVisible}">
                            <Image.Source>
                                <SvgImage Source="{Binding PasswordVisibility.EyeBlindIconUri}" />
                            </Image.Source>
                        </Image>
                        <Image Width="18" Height="18" Stretch="Uniform"
                               IsVisible="{Binding PasswordVisibility.IsVisible}">
                            <Image.Source>
                                <SvgImage Source="{Binding PasswordVisibility.EyeIconUri}" />
                            </Image.Source>
                        </Image>
                    </Panel>
                </Button>
              </Grid>
            </Grid>

            <StackPanel Grid.Row="2"
                        VerticalAlignment="Top"
                        HorizontalAlignment="Stretch"
                        Spacing="20"
                        Margin="0,12,0,0">

                <!-- 入力画面の強度バーと同じ高さ・同じ列の行。表示条件も強度バーと同じにして、
                     ステップ間でボタンの位置が動かないようにする（メーター OFF のときは行ごと消す）。
                     「暗号化」を押してパスワードが一致しなかったときは、メーターの設定に関係なく
                     この行を出して赤字でエラーを出す -->
                <Grid ColumnDefinitions="112,*,54" Margin="20,0,0,0" Height="16" HorizontalAlignment="Stretch">
                    <Grid.IsVisible>
                        <MultiBinding Converter="{x:Static BoolConverters.Or}">
                            <Binding Path="IsPasswordStrengthMeterVisible" />
                            <Binding Path="HasPasswordMismatch" />
                        </MultiBinding>
                    </Grid.IsVisible>
                    <TextBlock Grid.Column="1"
                               Text="{Binding PasswordMismatchMessage}"
                               IsVisible="{Binding HasPasswordMismatch}"
                               Foreground="{DynamicResource AppErrorForeground}"
                               FontSize="12"
                               VerticalAlignment="Center" />
                </Grid>

                <!-- 暗号化後に元のファイルを削除する（設定「メインウィンドウに削除のチェックボックスを表示する」が ON のときだけ。
                     入力欄と同じ列に置く） -->
                <Grid ColumnDefinitions="112,*,54" Margin="20,0,0,0" HorizontalAlignment="Stretch"
                      IsVisible="{Binding IsDeleteCheckBoxVisible}">
                    <CheckBox Grid.Column="1"
                              Content="{l:Localize Settings_DeleteOriginalAfterEncryption}"
                              IsChecked="{Binding DeleteOriginalAfterEncryption}"
                              FontSize="12" />
                </Grid>

                <StackPanel Orientation="Horizontal"
                            Spacing="8"
                            HorizontalAlignment="Right"
                            Margin="0,0,54,0"
                            IsVisible="{Binding IsPasswordFileMode}">
                    <TextBlock Text="{Binding PasswordFileLabel}"
                               FontSize="12"
                               VerticalAlignment="Center" />
                    <Button Content="{l:Localize PasswordFile_Clear}"
                            Command="{Binding ClearPasswordFileCommand}"
                            FontSize="11"
                            Padding="8,2" />
                </StackPanel>

                <!-- ボタン列は中央寄せではなく右寄せ。右端を入力欄の右端（= 右上の戻るボタンの左端、右から 54）に
                     揃える（利用者指示 2026-10-25: 中央寄せはやめる） -->
                <StackPanel Orientation="Horizontal"
                           HorizontalAlignment="Right"
                           Margin="0,0,54,0"
                           Spacing="10">
                    <Button Classes="action Primary" Content="{l:Localize Button_Encrypt}"
                           Command="{Binding EncryptCommand}"/>
                    <Button Classes="action" Content="{l:Localize Button_Back}"
                           Command="{Binding BackCommand}"/>
                </StackPanel>
            </StackPanel>
        </Grid>

        <!-- 暗号化処理中／完了画面 (Step 3, 4) -->
        <Grid IsVisible="{Binding IsProgressVisible}">
            <!-- 幅はウィンドウに追従（左 20 = 見出し、右 54 = 右上の戻るボタンぶん。入力欄と同じ）。
                 広げればプログレスバーもその上のパス表示も伸びて、長いパスを全部読める
                 （利用者要望 2026-10-25。以前は固定 500 で、最小幅では左右が欠けてもいた） -->
            <StackPanel VerticalAlignment="Center"
                       HorizontalAlignment="Stretch"
                       Spacing="10"
                       Margin="20,0,54,0">

                <TextBlock Text="{Binding StatusMessage}"
                          FontSize="18"
                          HorizontalAlignment="Center"
                          Margin="0,0,0,10"/>

                <!-- 処理中ファイルのフルパス（プログレスバー左上、長いパスは右側を…で省略） -->
                <TextBlock Text="{Binding CurrentFilePath}"
                          FontSize="12"
                          Margin="4,0,0,0"
                          Opacity="0.75"
                          HorizontalAlignment="Left"
                          TextWrapping="NoWrap"
                          TextTrimming="CharacterEllipsis"/>

                <ProgressBar Value="{Binding Progress}"
                            Minimum="0"
                            Maximum="100"
                            Height="30"
                            Foreground="Green" />

                <TextBlock Text="{Binding Progress, StringFormat='{}{0}%'}"
                          FontSize="16"
                          HorizontalAlignment="Center"/>

                <Button Classes="action" Content="{Binding ProgressButtonText}"
                        Command="{Binding CancelCommand}"
                        HorizontalAlignment="Right"
                        Margin="0,10,0,0"/>
            </StackPanel>
        </Grid>

        <!-- 右上の戻るボタン -->
        <Button Content="←"
                FontSize="24"
                Width="44"
                Height="44"
                HorizontalAlignment="Right"
                VerticalAlignment="Top"
                Margin="0,0,10,0"
                Command="{Binding BackCommand}"
                IsVisible="{Binding !IsProcessingStep}"/>
    </Grid>

</UserControl>
