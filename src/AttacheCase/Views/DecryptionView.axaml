<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:AttacheCase.ViewModels"
             xmlns:l="using:AttacheCase.Markup"
             xmlns:controls="using:AttacheCase.Controls"
             x:Class="AttacheCase.Views.DecryptionView"
             x:DataType="vm:DecryptionViewModel">

  <!-- 見出しは上端に置き、行では分けない。行に入れると、見出しの高さのぶんだけ
       入力欄が下へずれる -->
  <Grid>

    <!-- 対象のパス。左端は見出しの左端、右端は入力欄の右端（戻るボタンの左）に揃える。
         2 行まで全文、入らなければ PathTextBlock が途中を省略する -->
    <controls:PathTextBlock
      VerticalAlignment="Top"
      HorizontalAlignment="Stretch"
      Margin="20,60,54,0"
      Text="{Binding TargetPath}"
      FontSize="13"
      Opacity="0.8"
      TextWrapping="Wrap"
      MaxLines="2"/>

    <!-- パスワード入力ステップ

         入力欄そのものを画面の中心に据える。上下の * が同じ高さになるので、
         真ん中の Auto の行がちょうど中心に来る -->
    <Grid IsVisible="{Binding IsPasswordInputStep}" RowDefinitions="*,Auto,*">

      <TextBlock Grid.Row="0"
                 Text="{l:Localize Decryption_PasswordPrompt}"
                 FontSize="14"
                 HorizontalAlignment="Center"
                 VerticalAlignment="Bottom"
                 Margin="0,0,0,15"/>

      <!-- 入力欄は左端を見出しの左端（余白 20）に、右端を暗号化画面の入力欄と同じ位置（右上の
           戻るボタンぶん 54）にそろえる。コンボボックスが無いぶん左へ伸びる（利用者指示 2026-10-25） -->
      <Grid Grid.Row="1" Margin="20,0,54,0">
        <TextBox x:Name="PasswordBox"
                 PasswordChar="{Binding PasswordVisibility.PasswordChar}"
                 Text="{Binding Password}"
                 IsEnabled="{Binding !IsPasswordFileMode}"
                 Watermark="{l:Localize Encryption_PasswordPlaceholder}"
                 Padding="10,3,36,0"
                 Classes="password">
          <TextBox.KeyBindings>
            <KeyBinding Gesture="Enter" Command="{Binding DecryptCommand}" />
          </TextBox.KeyBindings>
        </TextBox>
        <Button Classes="eye"
                Command="{Binding PasswordVisibility.ToggleCommand}"
                ToolTip.Tip="{Binding PasswordVisibility.ToolTip}">
            <!-- SvgImage は Source を差し替えても Image が再描画されないため、
                 2 枚を用意して表示を切り替える -->
            <Panel>
                <Image Width="18" Height="18" Stretch="Uniform"
                       IsVisible="{Binding !PasswordVisibility.IsVisible}">
                    <Image.Source>
                        <SvgImage Source="{Binding PasswordVisibility.EyeBlindIconUri}" />
                    </Image.Source>
                </Image>
                <Image Width="18" Height="18" Stretch="Uniform"
                       IsVisible="{Binding PasswordVisibility.IsVisible}">
                    <Image.Source>
                        <SvgImage Source="{Binding PasswordVisibility.EyeIconUri}" />
                    </Image.Source>
                </Image>
            </Panel>
        </Button>
      </Grid>

      <StackPanel Grid.Row="2"
                  VerticalAlignment="Top"
                  HorizontalAlignment="Stretch"
                  Spacing="15"
                  Margin="0,15,0,0">

        <!-- 復号後に暗号化ファイルを削除する（設定「メインウィンドウに削除のチェックボックスを表示する」が ON のときだけ。
             入力欄と同じ左右位置） -->
        <CheckBox Content="{l:Localize Settings_DeleteEncryptedAfterDecryption}"
                  IsChecked="{Binding DeleteEncryptedFileAfterDecryption}"
                  IsVisible="{Binding IsDeleteCheckBoxVisible}"
                  FontSize="12"
                  Margin="20,0,54,0" />

        <StackPanel Orientation="Horizontal"
                    Spacing="8"
                    HorizontalAlignment="Right"
                    Margin="0,0,54,0"
                    IsVisible="{Binding IsPasswordFileMode}">
          <TextBlock Text="{Binding PasswordFileLabel}"
                     FontSize="12"
                     VerticalAlignment="Center" />
          <Button Content="{l:Localize PasswordFile_Clear}"
                  Command="{Binding ClearPasswordFileCommand}"
                  FontSize="11"
                  Padding="8,2" />
        </StackPanel>

        <!-- ボタン列は中央寄せではなく右寄せ。右端を入力欄の右端（= 右上の戻るボタンの左端、右から 54）に
             揃える（利用者指示 2026-10-25: 中央寄せはやめる） -->
        <StackPanel Orientation="Horizontal"
                    HorizontalAlignment="Right"
                    Margin="0,0,54,0"
                    Spacing="10">
          <Button Classes="action Primary" Content="{l:Localize Button_Decrypt}"
                  Command="{Binding DecryptCommand}"/>
          <Button Classes="action" Content="{l:Localize Button_Cancel}"
                  Command="{Binding CancelCommand}"/>
        </StackPanel>
      </StackPanel>
    </Grid>

    <!-- 処理中／完了ステップ -->
    <!-- 幅はウィンドウに追従（左 20、右は戻るボタンぶん 54。EncryptionView と同じ） -->
    <StackPanel IsVisible="{Binding IsProgressVisible}"
                Spacing="10"
                VerticalAlignment="Center"
                HorizontalAlignment="Stretch"
                Margin="20,0,54,0">

      <TextBlock Text="{Binding StatusMessage}"
                 FontSize="14"
                 HorizontalAlignment="Center"
                 Margin="0,0,0,10"/>

      <!-- 処理中ファイルのフルパス（プログレスバー左上、長いパスは右側を…で省略） -->
      <TextBlock Text="{Binding CurrentFilePath}"
                 FontSize="12"
                 Margin="4,0,0,0"
                 Opacity="0.75"
                 HorizontalAlignment="Left"
                 TextWrapping="NoWrap"
                 TextTrimming="CharacterEllipsis"/>

      <ProgressBar Value="{Binding Progress}"
                   Minimum="0"
                   Maximum="100"
                   Height="30"
                   Foreground="Green" />

      <TextBlock Text="{Binding Progress, StringFormat='{}{0}%'}"
                 FontSize="14"
                 HorizontalAlignment="Center"/>

      <Button Classes="action" Content="{Binding ProgressButtonText}"
              Command="{Binding CancelCommand}"
              HorizontalAlignment="Right"
              Margin="0,10,0,0"/>
    </StackPanel>

  </Grid>

</UserControl>
