<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:AttacheCase.ViewModels"
             xmlns:l="using:AttacheCase.Markup"
             xmlns:conv="using:AttacheCase.Converters"
             x:Class="AttacheCase.Views.DecryptionView"
             x:DataType="vm:DecryptionViewModel">

  <!-- 見出しは上端に置き、行では分けない。行に入れると、見出しの高さのぶんだけ
       入力欄が下へずれる -->
  <Grid>

    <Grid
      VerticalAlignment="Top"
      HorizontalAlignment="Stretch"
      Margin="20,56,20,0"
      ColumnDefinitions="Auto,*">

      <TextBlock
        Grid.Column="0"
        Text="{Binding HeaderText}"
        FontSize="18"
        FontWeight="Bold"
        VerticalAlignment="Center"/>

      <TextBlock
        Grid.Column="1"
        Text="{Binding TargetPath, Converter={x:Static conv:PathDisplayConverter.Instance}}"
        FontSize="18"
        FontWeight="Bold"
        VerticalAlignment="Center"
        TextWrapping="NoWrap"
        TextTrimming="CharacterEllipsis"/>
    </Grid>

    <!-- パスワード入力ステップ

         入力欄そのものを画面の中心に据える。上下の * が同じ高さになるので、
         真ん中の Auto の行がちょうど中心に来る -->
    <Grid IsVisible="{Binding IsPasswordInputStep}" RowDefinitions="*,Auto,*">

      <TextBlock Grid.Row="0"
                 Text="{l:Localize Decryption_PasswordPrompt}"
                 FontSize="14"
                 HorizontalAlignment="Center"
                 VerticalAlignment="Bottom"
                 Margin="0,0,0,15"/>

      <Grid Grid.Row="1" Width="400" HorizontalAlignment="Center">
        <TextBox x:Name="PasswordBox"
                 PasswordChar="{Binding PasswordVisibility.PasswordChar}"
                 Text="{Binding Password}"
                 IsEnabled="{Binding !IsPasswordFileMode}"
                 Watermark="{l:Localize Encryption_PasswordPlaceholder}"
                 Padding="10,3,36,0"
                 Classes="password">
          <TextBox.KeyBindings>
            <KeyBinding Gesture="Enter" Command="{Binding DecryptCommand}" />
            <KeyBinding Gesture="Escape" Command="{Binding CancelCommand}" />
          </TextBox.KeyBindings>
        </TextBox>
        <Button Classes="eye"
                Command="{Binding PasswordVisibility.ToggleCommand}"
                ToolTip.Tip="{Binding PasswordVisibility.ToolTip}">
            <!-- SvgImage は Source を差し替えても Image が再描画されないため、
                 2 枚を用意して表示を切り替える -->
            <Panel>
                <Image Width="18" Height="18" Stretch="Uniform"
                       IsVisible="{Binding !PasswordVisibility.IsVisible}">
                    <Image.Source>
                        <SvgImage Source="{Binding PasswordVisibility.EyeBlindIconUri}" />
                    </Image.Source>
                </Image>
                <Image Width="18" Height="18" Stretch="Uniform"
                       IsVisible="{Binding PasswordVisibility.IsVisible}">
                    <Image.Source>
                        <SvgImage Source="{Binding PasswordVisibility.EyeIconUri}" />
                    </Image.Source>
                </Image>
            </Panel>
        </Button>
      </Grid>

      <StackPanel Grid.Row="2"
                  VerticalAlignment="Top"
                  HorizontalAlignment="Center"
                  Spacing="15"
                  Margin="0,15,0,0">

        <StackPanel Orientation="Horizontal"
                    Spacing="8"
                    HorizontalAlignment="Center"
                    IsVisible="{Binding IsPasswordFileMode}">
          <TextBlock Text="{Binding PasswordFileLabel}"
                     FontSize="12"
                     VerticalAlignment="Center" />
          <Button Content="{l:Localize PasswordFile_Clear}"
                  Command="{Binding ClearPasswordFileCommand}"
                  FontSize="11"
                  Padding="8,2" />
        </StackPanel>

        <StackPanel Orientation="Horizontal"
                    HorizontalAlignment="Center"
                    Spacing="10">
          <Button Classes="action Primary" Content="{l:Localize Button_Decrypt}"
                  Command="{Binding DecryptCommand}"/>
          <Button Classes="action" Content="{l:Localize Button_Cancel}"
                  Command="{Binding CancelCommand}"/>
        </StackPanel>
      </StackPanel>
    </Grid>

    <!-- 処理中／完了ステップ -->
    <StackPanel IsVisible="{Binding IsProgressVisible}"
                Spacing="10"
                VerticalAlignment="Center"
                HorizontalAlignment="Center"
                Width="500">

      <TextBlock Text="{Binding StatusMessage}"
                 FontSize="14"
                 HorizontalAlignment="Center"
                 Margin="0,0,0,10"/>

      <!-- 処理中ファイルのフルパス（プログレスバー左上、長いパスは右側を…で省略） -->
      <TextBlock Text="{Binding CurrentFilePath}"
                 FontSize="11"
                 Opacity="0.75"
                 HorizontalAlignment="Left"
                 TextWrapping="NoWrap"
                 TextTrimming="CharacterEllipsis"/>

      <ProgressBar Value="{Binding Progress}"
                   Minimum="0"
                   Maximum="100"
                   Height="30"
                   Foreground="Green" />

      <TextBlock Text="{Binding Progress, StringFormat='{}{0}%'}"
                 FontSize="14"
                 HorizontalAlignment="Center"/>

      <Button Classes="action" Content="{Binding ProgressButtonText}"
              Command="{Binding CancelCommand}"
              HorizontalAlignment="Center"
              Margin="0,10,0,0"/>
    </StackPanel>

  </Grid>

</UserControl>
