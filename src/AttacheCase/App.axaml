<Application xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:local="using:AttacheCase"
             xmlns:shad="clr-namespace:ShadUI;assembly=ShadUI"
             x:Class="AttacheCase.App"
             RequestedThemeVariant="Default"
             Name="AttacheCase">

    <Application.DataTemplates>
        <local:ViewLocator />
    </Application.DataTemplates>

    <!-- アプリ独自の「面」の色（サイドバー・カード・ドロップ領域など）。
         テーマ設定（自動/ライト/ダーク）に追従させるため、ハードコードせず
         ここのテーマ辞書から DynamicResource で引く。
         ダーク時のアイコン（黒線 SVG）の再着色は未対応（既知の制限） -->
    <Application.Resources>
        <ResourceDictionary>
            <ResourceDictionary.ThemeDictionaries>
                <ResourceDictionary x:Key="Default">
                    <SolidColorBrush x:Key="AppMenuBarBackground">#F0F0F0</SolidColorBrush>
                    <SolidColorBrush x:Key="AppSidebarBackground">#F8F8F8</SolidColorBrush>
                    <SolidColorBrush x:Key="AppSidebarBorder">#E0E0E0</SolidColorBrush>
                    <SolidColorBrush x:Key="AppSidebarHover">#EDEDED</SolidColorBrush>
                    <SolidColorBrush x:Key="AppSidebarSelected">#CCCCCC</SolidColorBrush>
                    <SolidColorBrush x:Key="AppDropAreaBackground">#F5F5F5</SolidColorBrush>
                    <SolidColorBrush x:Key="AppDropAreaBorder">#CCCCCC</SolidColorBrush>
                    <SolidColorBrush x:Key="AppCardBackground">#FAFAFA</SolidColorBrush>
                    <SolidColorBrush x:Key="AppCardBorder">#E0E0E0</SolidColorBrush>
                    <!-- テキストのアクセント色。ライト値は従来のハードコードと同一なので
                         ライト表示は変わらない。ダークだけ明るめにして地の色から浮かせる -->
                    <SolidColorBrush x:Key="AppMutedForeground">#666666</SolidColorBrush>
                    <SolidColorBrush x:Key="AppAccentForeground">#2196F3</SolidColorBrush>
                    <SolidColorBrush x:Key="AppSuccessForeground">#2E7D32</SolidColorBrush>
                    <SolidColorBrush x:Key="AppErrorForeground">#B71C1C</SolidColorBrush>
                    <!-- パスワード確認欄の背景。一致 = 薄緑（旧 Windows 版 5.0 と同じ #EEFFEB、
                         利用者要望 2026-10-25。以前は白で「合った」ことが分かりにくかった）、
                         未入力・不一致 = 薄いオレンジ（従来どおり） -->
                    <SolidColorBrush x:Key="AppPasswordMatchBackground">#EEFFEB</SolidColorBrush>
                    <SolidColorBrush x:Key="AppPasswordMismatchBackground">#FFE4C4</SolidColorBrush>
                </ResourceDictionary>
                <ResourceDictionary x:Key="Dark">
                    <SolidColorBrush x:Key="AppMenuBarBackground">#1F1F1F</SolidColorBrush>
                    <SolidColorBrush x:Key="AppSidebarBackground">#252525</SolidColorBrush>
                    <SolidColorBrush x:Key="AppSidebarBorder">#3A3A3A</SolidColorBrush>
                    <SolidColorBrush x:Key="AppSidebarHover">#333333</SolidColorBrush>
                    <SolidColorBrush x:Key="AppSidebarSelected">#454545</SolidColorBrush>
                    <SolidColorBrush x:Key="AppDropAreaBackground">#2A2A2A</SolidColorBrush>
                    <SolidColorBrush x:Key="AppDropAreaBorder">#4A4A4A</SolidColorBrush>
                    <SolidColorBrush x:Key="AppCardBackground">#2A2A2A</SolidColorBrush>
                    <SolidColorBrush x:Key="AppCardBorder">#3F3F3F</SolidColorBrush>
                    <!-- ダーク用は地の暗い色から浮くよう明るめにする -->
                    <SolidColorBrush x:Key="AppMutedForeground">#A6A6A6</SolidColorBrush>
                    <SolidColorBrush x:Key="AppAccentForeground">#5AA9F0</SolidColorBrush>
                    <SolidColorBrush x:Key="AppSuccessForeground">#66BB6A</SolidColorBrush>
                    <SolidColorBrush x:Key="AppErrorForeground">#F28B82</SolidColorBrush>
                    <!-- ダークは暗い地に馴染む濃いめの緑 / 橙（文字色は明るいので淡色は使えない） -->
                    <SolidColorBrush x:Key="AppPasswordMatchBackground">#2B3F2B</SolidColorBrush>
                    <SolidColorBrush x:Key="AppPasswordMismatchBackground">#4A3A26</SolidColorBrush>
                </ResourceDictionary>
            </ResourceDictionary.ThemeDictionaries>
        </ResourceDictionary>
    </Application.Resources>

    <!-- macOS “アプリ名メニュー（左端）” は App に置く -->
    <NativeMenu.Menu>
        <NativeMenu>
            <!-- 文言は App.Initialize() でロケールに合わせて上書き -->
            <NativeMenuItem Header="About" Click="OnAboutMenuClick" />
            <NativeMenuItemSeparator />
            <NativeMenuItem Header="Check for Updates…" Click="OnCheckForUpdatesMenuClick" />
        </NativeMenu>
    </NativeMenu.Menu>

    <Application.Styles>

        <!-- 【お試し】shad-ui テーマ。戻すときは下の行を消して <SimpleTheme /> の
             コメントを外す（csproj の ShadUI 参照も消す） -->
        <shad:ShadTheme />
        <!-- <SimpleTheme /> -->

        <!-- ShadUI はクラス未指定のボタンを何も塗らない（Ghost 同然）。
             shadcn の「黒いボタン」は Primary バリアント（ダークでは白系）に
             割り当てられている（プローブで実測）。この app では:
               実行系（暗号化・復号・保存など）… Classes="Primary"
               それ以外（キャンセル・参照など）  … 既定で枠線 = Outline 相当
             OutlineColor は ShadUI のテーマリソースで、ライト/ダークに追従する。
             目玉ボタン（.eye）やサイドメニューは、後勝ちの個別スタイルが枠を消す -->
        <Style Selector="Button:not(.Primary):not(.Destructive)">
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="BorderBrush">
                <Setter.Value>
                    <SolidColorBrush Color="{DynamicResource OutlineColor}" />
                </Setter.Value>
            </Setter>
        </Style>

        <!-- 画面の主ボタン（暗号化・復号・次へ・キャンセル等）の標準サイズ。
             どの画面でも同じ大きさにそろえる -->
        <Style Selector="Button.action">
            <Setter Property="Width" Value="120" />
            <Setter Property="Height" Value="40" />
            <Setter Property="FontSize" Value="14" />
        </Style>


        <!-- パスワード入力欄の内側（右端）に重ねる目玉アイコンのボタン -->
        <Style Selector="Button.eye">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="BorderBrush" Value="Transparent" />
            <Setter Property="Padding" Value="4" />
            <Setter Property="MinWidth" Value="0" />
            <Setter Property="MinHeight" Value="0" />
            <Setter Property="HorizontalAlignment" Value="Right" />
            <Setter Property="VerticalAlignment" Value="Center" />
            <Setter Property="Margin" Value="0,0,6,0" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Focusable" Value="False" />
        </Style>
        <Style Selector="Button.eye /template/ ContentPresenter">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
        </Style>
        <Style Selector="Button.eye:pointerover /template/ ContentPresenter">
            <Setter Property="Background" Value="Transparent" />
        </Style>
        <Style Selector="Button.eye:pressed /template/ ContentPresenter">
            <Setter Property="Background" Value="Transparent" />
        </Style>
        <Style Selector="Button.eye Image">
            <Setter Property="Opacity" Value="0.65" />
        </Style>
        <Style Selector="Button.eye:pointerover Image">
            <Setter Property="Opacity" Value="1.0" />
        </Style>

        <!-- パスワード入力用TextBoxスタイル -->
        <Style Selector="TextBox.password">
            <!-- TextBox内部のTextPresenterの垂直位置を補正 -->
            <Setter Property="VerticalAlignment" Value="Center" />
            <Setter Property="VerticalContentAlignment" Value="Center" />
            <Setter Property="Height" Value="40" />
            <Setter Property="FontSize" Value="14" />
            <Setter Property="Padding" Value="10,3,10,0" />
        </Style>


    </Application.Styles>

</Application>