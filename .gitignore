# =============================================================================
# アタッシェケース5 for Mac
#
# いまはプライベートリポジトリだが、将来公開する可能性があるため、
# 秘密情報・個人環境に依存するもの・ビルド成果物は最初から追跡しない。
# =============================================================================

# ---- ビルド成果物 -----------------------------------------------------------
bin/
obj/
publish/
TestResults/
*.dmg
*.app/

# ---- IDE・エディタの個人設定 -------------------------------------------------
.idea/
.run/
.vs/
.vscode/
*.user
*.suo
*.userprefs
*.DotSettings.user

# ---- macOS ------------------------------------------------------------------
.DS_Store
._*
.Spotlight-V100
.Trashes
.AppleDouble
.LSOverride

# ---- 署名・公証 --------------------------------------------------------------
# 認証情報は release.env に分離してある（雛形は release.env.example）。
# スクリプト本体は秘密を含まないので追跡する
release.env

# 自動更新マニフェストの署名鍵。漏れると偽のマニフェストに署名されうる
# （最後の砦は codesign / TeamID 検証だが、鍵は鍵として守る）。
#
# 予備の鍵はここに置いたままにしないこと。現用と同じ場所にあると、
# 片方が漏れる状況では両方漏れる。作ったら別の保管場所へ移す。
# 移すまでの間に誤ってコミットしないよう、名前だけは押さえておく
appcast_ed25519.pem
appcast_ed25519_backup.pem
*.p12
*.cer
*.certSigningRequest
*.mobileprovision

# ---- 鍵・利用者データ（誤ってコミットしないための保険）------------------------
# RSA 鍵ファイル
*.atcpvt
*.atcpub
# Post-PPAP のアカウント情報とアプリ設定（実行時に ~/Library 配下へ作られるもの）
accounts.json
settings.json

# ---- 暗号化ファイル ----------------------------------------------------------
# 互換性テストに使う TestData のものだけは追跡する
*.atc
!tests/AttacheCase.Tests/TestData/**/*.atc

# ---- 鍵サーバ（Cloudflare Workers）------------------------------------------
# 実体は ~/Dropbox/AttacheCase5/attachecase-key-server にあり、このリポジトリの
# 外だが、持ち込まれても追跡しないようにしておく。公開予定はない
attachecase-key-server/
key-server/
wrangler.toml
wrangler.json
wrangler.jsonc
.wrangler/
.dev.vars
.dev.vars.*
node_modules/

# ---- その他 -----------------------------------------------------------------
*.log
*.tmp

# 個人用の一時ディレクトリ・ファイル（リポジトリ直下のみ）
# 先頭に / を付けて位置を固定する。付けないと Assets/Icons/_publickey.svg のような
# 配下の _ 始まりファイルまで巻き込んで、新規追加時に黙って無視されてしまう
/_*


# Claude Code の端末ローカル設定（権限許可など）。端末ごとに違うので追跡しない
.claude/settings.local.json

# 自己実行形式スタブの埋め込みソース（生成物・実質バイナリ。テンプレから生成）
/src/AttacheCase.Core/Exeout48.cs

# ---- ソースに埋め込まれていた秘密情報の隔離先 -----------------------------------
# 商用ライセンス（レジストレーションコード）復号用の RSA 秘密鍵など。
# 上の /_* でも除外されるが、意図を明示するため名前でも押さえる。
# リポジトリ側には空鍵の雛形（*.Secret.template.cs）だけを置く
/_secrets/
